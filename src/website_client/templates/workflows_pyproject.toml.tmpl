[build-system]
requires = ["poetry-core>=2.2,<3"]
build-backend = "poetry.core.masonry.api"

[project]
name = "$name"
version = "0.1.0"
description = "Guarded native Arazzo workflows from explicit bundled definitions"
requires-python = ">=3.11,<4"
dependencies = ["httpx>=0.28,<0.29", "playwright==1.64.1", "platformdirs>=4.3,<5", "filelock>=3.20,<4", "requests>=2.32,<3", "jsonpointer>=3,<4", "jsonschema>=4.23,<5", "openapi-schema-validator>=0.6,<0.9", "arazzo-runner==0.9.6+websiteclient.1"]

[project.scripts]
$name = "$package._cli:entrypoint"

[tool.poetry]
packages = [{ include = "$package" }]
