[build-system]
requires = ["poetry-core>=2.2,<3"]
build-backend = "poetry.core.masonry.api"

[project]
name = "$name"
version = "0.1.0"
description = "Generated GraphQL service client"
requires-python = ">=3.11,<4"
dependencies = ["httpx>=0.28,<0.29", "graphql-core>=3.2,<3.4", "pydantic>=2.10,<3", "playwright==1.64.1", "platformdirs>=4.3,<5", "filelock>=3.20,<4"]

[project.scripts]
$name = "$package._cli:entrypoint"

[tool.poetry]
packages = [{ include = "$package" }]
