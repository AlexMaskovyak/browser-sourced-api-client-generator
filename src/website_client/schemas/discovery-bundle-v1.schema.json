{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Website Client discovery bundle, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "stage", "producer", "createdAt", "artifacts", "services"],
  "properties": {
    "format": {"const": "website-client-discovery"},
    "version": {"type": "integer", "const": 1},
    "stage": {"enum": ["discovery", "normalized"]},
    "producer": {"$ref": "#/$defs/producer"},
    "createdAt": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/artifact"}},
    "services": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/service"}},
    "sourceBundles": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["sha256", "producer", "createdAt"], "properties": {"sha256": {"$ref": "#/$defs/hash"}, "producer": {"$ref": "#/$defs/producer"}, "createdAt": {"type": "string", "format": "date-time"}}}},
    "normalization": {"type": "object", "additionalProperties": false, "required": ["policyVersion", "unassignedArtifacts", "notes"], "properties": {"policyVersion": {"const": 1}, "unassignedArtifacts": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "notes": {"type": "array", "items": {"type": "string"}}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "content", "sha256", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "kind": {"enum": ["report", "har", "openapi", "graphql-schema", "graphql-operations"]},
        "content": {"type": "string"},
        "sha256": {"$ref": "#/$defs/hash"},
        "provenance": {
          "type": "object", "additionalProperties": false, "required": ["source", "locations", "derivedFrom", "producers"],
          "properties": {
            "source": {"enum": ["captured", "downloaded", "inferred", "frontend", "external", "normalized", "report"]},
            "locations": {"type": "array", "maxItems": 1000, "items": {"type": "string", "maxLength": 8192}},
            "derivedFrom": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/id"}},
            "producers": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/producer"}}
          }
        }
      }
    },
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "protocol", "endpoint", "schemaArtifact", "operationArtifacts", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "protocol": {"enum": ["openapi", "graphql"]},
        "endpoint": {"type": "string", "maxLength": 8192},
        "schemaArtifact": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "operationArtifacts": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/id"}},
        "confidence": {"enum": ["published", "inferred", "external", "observed", "declared"]},
        "status": {"enum": ["ready", "review_required", "blocked"]},
        "issues": {"type": "array", "items": {"type": "string"}},
        "operationNames": {"type": "array", "items": {"type": "string"}},
        "sourceSchemaArtifact": {"$ref": "#/$defs/id"},
        "compiledOperationsArtifact": {"$ref": "#/$defs/id"}
      }
    }
  }
}
