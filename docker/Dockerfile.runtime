FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
RUN useradd --create-home --uid 1000 tester
COPY wheels /wheels
RUN python -m pip install --no-index --find-links=/wheels /wheels/*client*.whl /wheels/*workflows*.whl /wheels/arazzo_runner-0.9.6+websiteclient.1-py3-none-any.whl pytest && rm -rf /wheels
COPY driver /acceptance
USER tester
ENV HOME=/home/tester
WORKDIR /tmp
CMD ["python", "/acceptance/acceptance_runtime.py"]
